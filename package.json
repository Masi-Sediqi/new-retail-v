{
  "name": "smart-office",
  "version": "1.0.0",
  "description": "Smart Office Management System",
  "main": "electron/main.cjs",
  "author": "Larmoond Dev",
  "private": true,
  "scripts": {
    "backend:dev": "node transport-backend/server.cjs",
    "dev": "concurrently -k \"npm run backend:dev\" \"vite\"",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build:web": "vite build",
    "build:desktop": "npm run build:web && electron-builder --win",
    "build:portable": "npm run build:web && electron-builder --win portable"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fs-extra": "^11.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.4",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "vite": "^7.0.0",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.larmoond.smartoffice",
    "productName": "Smart Office",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "transport-backend/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "transport-backend/**/*",
      "node_modules/fs-extra/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Smart-Office-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Smart Office"
    }
  }
}
